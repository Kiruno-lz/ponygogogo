# Public frontend build variables. Vite embeds every VITE_* value in the browser bundle.
# Alchemy recommends proxying API key + policy ID server-side for production; these are testnet
# client settings only. Restrict the app to the real site origin and Monad Testnet, and cap spend.
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CANONICAL_HOST=ponygo.kiruno.cc
VITE_ALCHEMY_API_KEY=
VITE_ALCHEMY_POLICY_ID=
# Deployed contract addresses (Monad Testnet). Empty = not deployed: the wallet shows the Vault as
# not deployed and paid races stay closed. Filling both does not open paid races by itself — that
# also needs PAID_RACE_FEATURE in src/chain/paidGate.ts. Addresses are never read from URL params.
VITE_PONY_VAULT_ADDRESS=
VITE_PONY_GAME_ADDRESS=

# Local testnet deployment configuration. After one-time decryption, store the same
# account's raw private key in this ignored, mode-0600 file for unattended Foundry use.
ETH_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY_PATH=keys/ponygogogo-monad-testnet.private
# Reuse the persistent reward ledger when creating a new Game version. Empty creates the first ledger.
PONY_REWARDS=
# Temporary source for the one-time export; remove after address verification.
DEPLOYER_KEYSTORE_PATH=keys/ponygogogo-monad-testnet

# Envio HyperIndex (event history, not funds). ENVIO_API_TOKEN is a HyperSync API token from
# https://envio.dev/app/api-tokens, used only when running the indexer locally against HyperSync
# (https://monad-testnet.hypersync.xyz); Envio Cloud deployments get HyperSync access without it.
# HyperRPC is not used. Never rename it to VITE_*.
ENVIO_API_TOKEN=
# Public GraphQL endpoint of the deployed Envio Cloud indexer, read by the browser for history.
VITE_ENVIO_GRAPHQL_URL=

# Cloudflare Wrangler CLI credentials. Prefer `wrangler login` locally; for automation use a
# short-lived, account-scoped API token with only the Workers/D1 permissions the task needs.
# Never rename these to VITE_*; Wrangler reads them in the local shell, not in the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
