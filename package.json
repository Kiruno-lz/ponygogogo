{
  "name": "ponygogogo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "bun run build && npx wrangler dev --local",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -b",
    "test": "bun test src",
    "check:paid-cards": "bun scripts/gen-paid-card-rules.ts --check",
    "check:paid-vectors": "bun scripts/gen-paid-vectors.ts --check",
    "check:pony-rules": "bun scripts/gen-pony-rules.ts --check",
    "check:reward-rules": "bun scripts/gen-reward-rules.ts --check",
    "check:pony-vectors": "bun scripts/gen-pony-vectors.ts --check",
    "check:contracts": "bun scripts/check-contract-sizes.ts",
    "check:solver-monad": "bun --no-env-file scripts/measure-paid-solver.ts",
    "assets": "python3 scripts/build-web-assets.py",
    "assets:masters": "python3 scripts/process-assets.py && python3 scripts/postprocess-assets.py && python3 scripts/prepare-art.py",
    "assets:measure": "bun scripts/measure-display-sizes.ts",
    "test:api": "bun test tests/api",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@alchemy/wallet-apis": "^5.2.7",
    "@category-labs/mera": "^0.2.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "html-to-image": "^1.11.13",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.56.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "^1.50.0",
    "@types/bun": "^1.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pngjs": "7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
